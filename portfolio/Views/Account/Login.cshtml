@{
    ViewData["Title"] = "Admin Login";
}

<div class="row mt-5 animate-fade-in">
    <div class="col-md-4 mx-auto">
        <div class="card shadow-sm border-0 p-4 rounded-3">
            <h3 class="fw-bold text-center mb-4">Admin Login</h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center">@ViewBag.Error</div>
            }

            <form method="post" asp-action="Login">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input type="text" name="username" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill mt-2">Login</button>
            </form>
        </div>
    </div>
</div>