@model List<LukashPortfolio.Models.ContactMessage>
@{
    ViewData["Title"] = "Inbox";
}

<div class="container mt-5 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0">Contact Inbox</h2>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">Logout</a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info text-center shadow-sm">
            No messages found in your inbox.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Message</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model)
                    {
                        <tr>
                            <td class="text-nowrap small text-muted">@msg.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="fw-bold">@msg.Name</td>
                            <td><a href="mailto:@msg.Email" class="text-decoration-none">@msg.Email</a></td>
                            <td>@msg.Message</td>
                            <td class="text-center">
                                <form method="post" asp-action="DeleteMessage" asp-route-id="@msg.Id" onsubmit="return confirm('Are you sure you want to delete this message?');">
                                    @* CSRF protection for delete requests *@
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>